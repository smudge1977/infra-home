homeassistant: true
mqtt:
  base_topic: zigbee2mqtt
  server: mqtt://mosquitto:1883
  user: zigbee2mqtt
  password: replace-with-secure-password
frontend:
  enabled: true
  port: 8080
serial:
  # Temporary USB coordinator; replace when the PoE coordinator arrives.
  port: /dev/ttyACM0
advanced:
  cache_state: true
  homeassistant_legacy_entity_attributes: false
  legacy_api: false
  legacy_availability_payload: false
experimental:
  new_state_topics: false
device_options:
  legacy: false