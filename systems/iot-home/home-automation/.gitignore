# Local runtime secrets
.env
.env.*
!.env.example
config/mosquitto/passwordfile
config/mosquitto/aclfile
config/zigbee2mqtt/configuration.yaml
config/zigbee2mqtt/secret.yaml
config/zigbee2mqtt/secrets.yaml

# Generated state and broker data
config/mosquitto/data/*
config/mosquitto/log/*
config/zigbee2mqtt/*.db
config/zigbee2mqtt/*.db.*
config/zigbee2mqtt/*.log
config/zigbee2mqtt/log/
config/zigbee2mqtt/state.json
config/zigbee2mqtt/coordinator_backup.json
config/zigbee2mqtt/configuration_backup*.yaml

# Keep directory structure tracked
!config/mosquitto/data/.gitkeep
!config/mosquitto/log/.gitkeep
