server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root {{ wordpress_document_root }};
    index index.php index.html;
    client_max_body_size {{ wordpress_php_upload_max_filesize }};
    server_tokens off;

    access_log /var/log/nginx/wordpress-access.log;
    error_log /var/log/nginx/wordpress-error.log warn;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location = /xmlrpc.php {
        deny all;
    }

    location ~* /(?:\.git|\.svn|\.hg|\.env|\.ht) {
        deny all;
    }

    location ~* ^/wp-content/uploads/.*\.php$ {
        deny all;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php{{ wordpress_php_version }}-fpm.sock;
    }

    location ~* \.(?:css|gif|ico|jpeg|jpg|js|png|svg|webp)$ {
        expires 7d;
        access_log off;
    }
}
