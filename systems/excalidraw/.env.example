# Proposed hostname only: DNS, TLS and host placement have not been provisioned.
APP_HOST=draw.keithmarston.me.uk

# Upstream release tags are compatibility baselines, not a security endorsement.
# Review vulnerabilities and record image digests before production deployment.
FRONTEND_IMAGE=alswl/excalidraw:v0.18.1-fork-b2
STORAGE_IMAGE=alswl/excalidraw-storage-backend:v2023.11.11
ROOM_IMAGE=alswl/excalidraw-room-go:v0.1.0
MONGO_IMAGE=mongo:7.0.5-jammy

# Host nginx connects to these loopback-only listeners.
FRONTEND_PORT=9013
STORAGE_PORT=9014
ROOM_PORT=9015

# Replace BOTH placeholders in a protected local .env before starting.
# Use independent random hexadecimal passwords (at least 32 characters).
# The app password is embedded in a URI: do not use unescaped URI delimiters.
MONGO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ROOT_HEX_PASSWORD
MONGO_APP_PASSWORD=REPLACE_WITH_RANDOM_APP_HEX_PASSWORD