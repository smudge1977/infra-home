# Host nginx template, NOT a container config or an automatically installed vhost.
# Match server_name/certificate paths to APP_HOST, and ports to the local .env.
# This template has no authentication. Restrict ingress to trusted LAN/VPN clients
# before enabling it. Do not expose it directly to the Internet.
server {
    listen 80;
    server_name draw.keithmarston.me.uk;
    return 301 https://draw.keithmarston.me.uk$request_uri;
}

server {
    listen 443 ssl;
    server_name draw.keithmarston.me.uk;

    ssl_certificate /etc/letsencrypt/live/draw.keithmarston.me.uk/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/draw.keithmarston.me.uk/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 40m;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location / {
        proxy_pass http://127.0.0.1:9013;
    }

    # Strip /storage/ only; the backend must still receive /api/v2/....
    location /storage/ {
        proxy_pass http://127.0.0.1:9014/;
    }

    location /socket.io/ {
        proxy_pass http://127.0.0.1:9015;
        proxy_http_version 1.1;
        # These repeat the shared headers because location-level proxy_set_header
        # directives replace (rather than extend) the inherited set.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}